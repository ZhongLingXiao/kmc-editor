;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

;Astral Ready
[State -2]
type = Helper
triggerall = !NumExplod(5999)
trigger1 = power >= 2000
trigger1 = roundstate = 2
trigger1 = p2life <= (enemynear,lifemax)*.25
trigger1 = var(21) = 0
trigger1 = fvar(35) <= 0
triggerall = !numhelper(9877)
triggerall = stateno != [4000,4999]
helpertype = normal
ID = 9877
Stateno = 9877
pos = 0,0
PosType = p1
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = 1
size.yscale = 1
ignorehitpause = 1
pausemovetime = 999
supermovetime = 999
persistent = 0

