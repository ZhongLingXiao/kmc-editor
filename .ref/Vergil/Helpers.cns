;---------------------------------------------------------------------------
;Box
[Statedef 250]
type    = S                     ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                     ;Move-type: A-attack, I-idle, H-gethit
physics = N                     ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0       
anim = 250                ;Set ctrl (Def: no change)                   ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 3 

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 0, Width]
type = Width
trigger1 = 1
player = 30,10

[State 0, PosSet]
type = PosSet
trigger1 = 1
x = root,pos x

[State 0, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = root,stateno != 1105

;---------------------------------------------------------------------------
;Box
[Statedef 251]
type    = S                     ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                     ;Move-type: A-attack, I-idle, H-gethit
physics = N                     ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0       
anim = 251                ;Set ctrl (Def: no change)                   ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 3 

;This helper (sorta) prevent P2 from turning when pressing back, thus enabling them to block.

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 0, Width]
type = null;Width
trigger1 = 1
player = 30,10

[State 0, PosSet]
type = null;PosSet
trigger1 = 1
x = root,pos x

[State 0, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 0
value = 0

[State 0, DestroySelf]
type = DestroySelf
trigger1 = root,stateno != 203
trigger2 = root,stateno != 1110
trigger3 = root,stateno != 3005

